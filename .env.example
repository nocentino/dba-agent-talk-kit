# SQL Server Configuration
SA_PASSWORD=YourStrongPasswordHere!
ACCEPT_EULA=Y

# Application account passwords — these are hardcoded literals inside
# scripts/init-sqlserver1.sql / init-sqlserver2.sql (CREATE LOGIN ... WITH
# PASSWORD = '...'), not templated. If you change them here, you must also
# change them in both init scripts, or the MCP server's INSTANCES entries
# below will fail to authenticate.
MONITOR_PASSWORD=MonitorP@ss123!
DAB_PASSWORD=DabP@ss123!

# Database Configuration
SQL_DATABASE=ProductsDB

# SQL Server DBA MCP Server — instance configuration
# INSTANCES is a JSON array of named SQL Server connections.
# The "SqlServer1" instance is used when no instance_name is specified.
# Call the list_instances tool to discover all available instances.
INSTANCES='[
  {
    "name":     "SqlServer1",
    "host":     "sqlserver1",
    "port":     1433,
    "user":     "dba_monitor",
    "password": "MonitorP@ss123!"
  },
  {
    "name":     "SqlServer2",
    "host":     "sqlserver2",
    "port":     1433,
    "user":     "dba_monitor",
    "password": "MonitorP@ss123!"
  }
]'
